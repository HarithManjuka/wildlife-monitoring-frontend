# ==============================================================================
# Wildlife Monitoring Frontend - Professional .gitignore
# ==============================================================================

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Production Build Output
dist/
dist-ssr/
build/

# Environment Variables & Sensitive Credentials
# Keep local configurations and keys untracked
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Bundler & Tooling Caches
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.cache/
.eslintcache
.oxlintcache
*.tsbuildinfo

# Testing and Coverage
coverage/
*.lcov
.nyc_output/

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
